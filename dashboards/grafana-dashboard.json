        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "rate(go_gc_duration_seconds_sum{job=\"green-tea-gc\"}[1m]) / rate(go_gc_duration_seconds_count{job=\"green-tea-gc\"}[1m])",
